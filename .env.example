# ============================================================
# AgentV — environment template
# Copy to .env and fill with the deployment's real values, then
# run ./setup/bootstrap.sh. NOTHING here is committed (.env is gitignored).
# ============================================================

# --- Control-plane database (MySQL 8) ---
# One MySQL instance; this schema holds the fleet's control plane.
# Per-project app schemas are created later, one per app the fleet builds.
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=agentv          # control-plane schema name (e.g. client slug)

# --- Control-plane API/dashboard ---
SERVER_PORT=8100
NODE_ENV=production
JWT_SECRET=                    # generate: openssl rand -hex 48
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin           # dashboard login (seeded at bootstrap)
ADMIN_PASSWORD=                # blank = auto-generated + printed once during bootstrap
CORS_ORIGINS=
CONTROL_PLANE_API=http://localhost:8100   # base URL skills use to reach the dashboard API (ideas, reports)

# --- Public surface / URLs ---
# DASHBOARD_DOMAIN is the ONE public URL for the control plane. The API is served
# at https://<DASHBOARD_DOMAIN>/v1 (provision.sh proxies it; build-app.sh points
# the SPA there via VITE_API_URL). Leave DASHBOARD_DOMAIN empty for local-only:
# app → http://localhost:DASHBOARD_APP_PORT, api → http://localhost:SERVER_PORT.
DASHBOARD_DOMAIN=              # e.g. dashboard.example.com  (dashboard + /v1 api)
DASHBOARD_APP_PORT=8101        # local served port for the SPA (defaults to SERVER_PORT+1)
APP_DOMAIN_BASE=               # wildcard base for apps the FLEET builds, e.g. example.com (<name>.example.com)
# Ports the fleet may use for new apps it builds (port-allocate picks free ones here):
PORT_RANGE_FROM=8200
PORT_RANGE_TO=8999

# --- AI / agent runtime ---
# Claude Code authenticates via its own login/subscription on the box (not an env key here).
OPENROUTER_API_KEY=            # image generation + multi-provider fallback (optional at 2-agent stage)
DEFAULT_AGENT_MODEL=claude-sonnet-4-6   # default model written to new agent rows

# --- GitHub (agents open/merge PRs) ---
GITHUB_ORG=                    # org that holds project + agent repos
# gh CLI must be authenticated on the box (gh auth login) — token not stored here.

# --- Fleet ---
# The single starter agent — the coordinator. Name it whatever you like (Norman,
# AgentV, …); the slug is the lowercased-kebab form used for the dir/session/DB.
FLEET_MANAGER_NAME=Fleet Manager   # display name (Claude Desktop + dashboard)
FLEET_MANAGER_SLUG=fleet-manager   # dir/session/DB slug; skipped by wrap-up-all broadcasts

# --- Outbound email relay (REQUIRED — cloud IPs are usually blocklisted) ---
MAIL_PROVIDER=brevo            # brevo | sendgrid | ses | smtp
MAIL_API_KEY=
MAIL_FROM=                     # e.g. fleet@example.com
ADMIN_NOTIFY_TO=               # where digests/alerts go (the human)

# --- Paths ---
# Leave UNSET — they default to absolute repo-relative paths (<repo>/agents, <repo>/shared)
# resolved by shared/lib/agentv-env.sh. Only set these if relocating dirs, and use
# ABSOLUTE paths (relative paths break skills run from other CWDs).
# AGENTS_DIR=/abs/path/to/agents
# SHARED_DIR=/abs/path/to/shared
