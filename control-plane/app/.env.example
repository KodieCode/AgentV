# Control-plane dashboard — frontend env (Vite). Copy to .env.
# Everything client/deployment-specific lives here; nothing is hardcoded in src.

# Base URL of the control-plane API. The dashboard prefixes all /v1/* calls
# with this. In local dev point it at the API dev port; in production point it
# at the public API origin.
VITE_API_URL=http://localhost:8100

# Brand name shown in the sidebar + login. Generic by default.
VITE_APP_NAME=Control Plane

# Dev server port (vite). Optional — defaults to 5173.
VITE_DEV_PORT=5173

# Public host the dashboard is served from (for allowedHosts + HMR over TLS).
# Leave blank for pure-local dev.
VITE_DASHBOARD_HOST=
